# Set these in Supabase -> Edge Functions -> Secrets, never in Pages or the APK.
TRACKER_WEB_ORIGIN=https://mozdbaranarshiya.github.io
TRACKER_SETUP_TOKEN=replace-with-a-random-private-token-of-at-least-32-characters
TRACKER_ENCRYPTION_KEY=replace-with-64-random-hex-digits
# SUPABASE_URL and the server-side Supabase key are injected by Supabase.
